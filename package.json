{
  "name": "pacifico",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:og": "bun run scripts/generate-og.tsx",
    "preview": "vite preview",
    "start": "bun run server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc -b --pretty false",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "test": "bun run test:unit && bun run test:server",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:server": "bun test ./tests/server.bun.ts"
  },
  "dependencies": {
    "@atcute/atproto": "4.0.4",
    "@atcute/bluesky": "4.0.20",
    "@atcute/client": "5.1.1",
    "@atcute/crypto": "^2.4.4",
    "@atcute/did-plc": "^1.0.1",
    "@atcute/identity": "2.0.2",
    "@atcute/identity-resolver": "2.0.1",
    "@atcute/multibase": "^1.2.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@catppuccin/tailwindcss": "^1.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "satori": "^0.33.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
